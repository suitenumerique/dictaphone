flowchart TD
    Create["File creation<br/>creator.email"] --> Runtime["get_runtime_configuration()<br/>validate policies and buckets; build lookup maps"]
    Runtime --> Email{"Exact normalized email matched?"}
    Email -->|"yes"| EmailProfile["profiles_by_email[email]"]
    Email -->|"no"| Domain{"Normalized email domain matched?"}
    Domain -->|"yes"| DomainProfile["profiles_by_domain[domain]"]
    Domain -->|"no"| Default["default_profile"]

    EmailProfile --> Profile["ResolvedDomainProfile"]
    DomainProfile --> Profile
    Default --> Profile

    Profile --> Snapshot["File.save() persists snapshot<br/>retention deadlines + object references"]

    Snapshot --> Storage["get_storage_for_object(object)<br/>routes by the object bucket and key"]

    Existing["Existing file operation"] --> Persisted["Follow the owning model object reference<br/>use the recorded location"]
    Persisted --> Storage

    Media["Media request through Nginx"] --> Auth["/files/media-auth/"]
    Auth --> BucketCheck{"Requested URL bucket<br/>matches a tracked media object?"}
    BucketCheck -->|"no"| Deny["403 denied"]
    BucketCheck -->|"yes"| Signed["Generate S3 authorization headers"]

    Note["Policy selection happens at file creation.<br/>Later configuration changes do not move existing files; object records and retention deadlines stay authoritative."]
    Snapshot -.-> Note

    classDef decision fill:#fff4dc,stroke:#b7791f,color:#4a2c00
    classDef storage fill:#e8f1ff,stroke:#356ae6,color:#102a56
    classDef policy fill:#eaf8ef,stroke:#238636,color:#123b1d
    class Email,Domain,BucketCheck decision
    class Storage,Final,Signed storage
    class Runtime,EmailProfile,DomainProfile,Default,Profile,Snapshot,Persisted policy
