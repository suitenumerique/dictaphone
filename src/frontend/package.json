{
  "name": "dictaphone",
  "private": true,
  "version": "0.12.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-theme": "cunningham -g css,scss,ts -o src/styles && mv src/styles/cunningham-tokens.scss src/styles/cunningham-tokens-sass.scss",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives",
    "preview": "vite preview",
    "format": "oxfmt --write ./src",
    "check": "oxfmt --check ./src"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@formatjs/intl-durationformat": "0.11.1",
    "@gouvfr-lasuite/cunningham-react": "4.3.0",
    "@gouvfr-lasuite/ui-kit": "0.25.0",
    "@react-aria/toast": "3.1.1",
    "@react-types/overlays": "3.10.0",
    "@tanstack/react-query": "5.104.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "hoofd": "1.7.3",
    "humanize-duration": "3.35.0",
    "i18next": "26.4.2",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-resources-to-backend": "1.2.3",
    "idb": "8.0.3",
    "marked": "18.0.14",
    "posthog-js": "1.434.18",
    "pretty-bytes": "7.2.0",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-dropzone": "15.0.0",
    "react-i18next": "17.0.15",
    "react-toastify": "11.1.0",
    "uuid": "14.0.2",
    "wouter": "3.11.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/eslint-plugin-query": "5.104.0",
    "@tanstack/react-query-devtools": "5.104.0",
    "@types/humanize-duration": "3.27.4",
    "@types/node": "^24.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "1.86.0",
    "oxfmt": "0.71.0",
    "postcss": "8.5.28",
    "sass-embedded": "1.105.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.2"
  }
}
